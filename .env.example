# Copy to .env (git-ignored) and fill in. Never commit real values.
GSI_PORT=3000
# Shared secret the companion app and CS2 config must send; use a long random string.
GSI_AUTH_TOKEN=
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Optional: save one raw GSI payload per game state here, e.g. recordings
# GSI_RECORD_DIR=recordings
# Discord bot: set all three or none (see docs/discord-setup.md)
# DISCORD_TOKEN=
# DISCORD_CLIENT_ID=
# DISCORD_GUILD_ID=
# Optional console relay: posts CS2 console output to a Discord channel (see docs/console-relay.md).
# Needs the three DISCORD_* values. Launch CS2 with -condebug so it writes console.log.
# CS2_CONSOLE_LOG=C:\Program Files (x86)\Steam\steamapps\common\Counter-Strike Global Offensive\game\csgo\console.log
# DISCORD_CONSOLE_CHANNEL_ID=
# Optional regex: relay only matching lines, e.g. Damage|killed|\[ALL\]|\[CT\]|\[T\]
# CONSOLE_FILTER=
